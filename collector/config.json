  "display": {
    "FR": {
      "channel": "48% of French SMEs work with a chartered accountant, close to 80% of the smallest ones (Chift survey 2026). Larger SMEs often keep accounting in house.",
      "reform": "Receiving is mandatory for all companies since 1 September 2026. Issuing extends to SMEs on 1 September 2027.",
      "network": "Approved private platforms (plateformes agréées). Peppol is optional.",
      "note": "Three layers: accountant suites (Cegid Quadra, Sage Génération Experts, ACD), cloud platforms shared by firms and SMEs (Pennylane), in-house SME software (Sage 100, EBP). Each Sage and Cegid product is a separate integration."
    },
    "DE": {
      "channel": "Accounting is delegated to the Steuerberater for most SMEs, more than in any other market of Chift's 2026 survey.",
      "reform": "Receiving is mandatory since 2025. Issuing becomes mandatory in 2027 above EUR 800,000 of turnover, and for everyone in 2028.",
      "network": "No mandated network. XRechnung or ZUGFeRD format. Peppol is an option.",
      "note": "The SME layer is cloud (Lexware Office, sevdesk). DATEV runs both on premise and in the cloud. ADDISON and Agenda barely show in SME surveys but matter through accountants."
    },
    "BE": {
      "channel": "Accountants run the full workflow for most SMEs. Below 50 employees, accounting is almost entirely outsourced (Chift survey 2026).",
      "reform": "B2B e-invoicing is mandatory since 1 January 2026, for sending and receiving.",
      "network": "Peppol, for all VAT-liable companies at once.",
      "note": "Two markets. Flanders is mostly cloud (Exact Online, Octopus, Adsolut, Yuki). Wallonia is more on premise (Horus, WinBooks, Sage BOB 50, Odoo)."
    }
  },
