# Everything runs without any key: MOCK_MODE is true unless set to "false".
MOCK_MODE=true

# Real adapters, used only when MOCK_MODE=false and the key is present.
HUBSPOT_TOKEN=
SLACK_WEBHOOK_URL=
ENRICHMENT_API_KEY=
EMAIL_API_KEY=

# Booking link shown on the report ("Talk to a Chift expert").
BOOKING_URL=https://www.chift.eu/contact
